# =============================================================================
# Vector platform configuration — the entire human-set surface.
#
# Quick start:  cp .env.example .env  → fill the three Required values
#               → ./vector up -d      (generates internal secrets, starts compose)
#
# Everything that used to live here is now either derived in code from
# VECTOR_DOMAIN, hardcoded in docker-compose.yml, or auto-generated by ./vector.
# Any Spring property remains overridable via relaxed binding — see README
# "Environment variables".
# =============================================================================

# --- Required (set once) ------------------------------------------------------

# Base domain for the platform. Hostnames derive from it:
#   dashboard   deploy.<domain>            user apps   <app>.apps.<domain>
#   API         api.deploy.<domain>
# Local dev: keep `localhost` — *.localhost routes to loopback, no DNS needed.
VECTOR_DOMAIN=localhost

# Password for the dashboard login screen.
VECTOR_DASHBOARD_PASSWORD=change_me

# Gemini API key for AI features (free key: https://aistudio.google.com/apikey).
VECTOR_GEMINI_API_KEY=

# --- Optional (feature enablement / overrides) ---------------------------------

# Subdomain segment for deployed apps. Default `apps`; set to empty
# (VECTOR_APP_NAMESPACE=) to put apps directly on the root domain.
#VECTOR_APP_NAMESPACE=apps

# GitHub PAT for commit metadata + connect-a-repo. Degrades silently when unset.
#VECTOR_GITHUB_TOKEN=

# Deploy notification emails (Resend). Both required to enable.
#VECTOR_RESEND_API_KEY=
#VECTOR_RESEND_TO=you@example.com

# Authenticated DockerHub pulls (read-only token from hub.docker.com/settings/security).
#VECTOR_DOCKERHUB_USER=
#VECTOR_DOCKERHUB_TOKEN=

# Per-host escape hatches over the derived scheme.
#VECTOR_DOMAIN_WEB=
#VECTOR_DOMAIN_API=

# Comma-separated reverse-proxy IPs whose X-Forwarded-For is trusted (rate limiting).
#VECTOR_TRUSTED_PROXIES=

# Host path of the Docker socket (macOS OrbStack: ~/.orbstack/run/docker.sock).
#VECTOR_DOCKER_SOCKET_PATH=/var/run/docker.sock

# --- Optional: GitHub App (repo connect / dashboard deploys) -------------------
# Created automatically by the dashboard setup wizard (Settings → GitHub App) —
# only set these to override the wizard-stored credentials (e.g. GitOps/k8s path).
#VECTOR_GITHUB_APP_ID=
#VECTOR_GITHUB_APP_PRIVATE_KEY=          # path to PEM file, or base64-encoded PEM
#VECTOR_GITHUB_APP_WEBHOOK_SECRET=

# --- HTTPS overlay only (docker-compose.https.yml, VPS) ------------------------

# Let's Encrypt contact email (expiry notices).
#VECTOR_ACME_EMAIL=

# =============================================================================
# Internal secrets (VECTOR_API_KEY, VECTOR_SESSION_SECRET, VECTOR_DB_PASS,
# VECTOR_ANALYZER_DB_PASS, VECTOR_DEPLOY_HOOK_SECRET, VECTOR_ENCRYPTION_KEY,
# VECTOR_UPDATER_AUTH_TOKEN) are appended below this line by ./vector on first
# run. Never edit them. BACK UP VECTOR_ENCRYPTION_KEY — losing it makes stored
# encrypted app env vars unreadable.
# =============================================================================
