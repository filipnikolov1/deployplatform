# =============================================================================
# Vector platform environment configuration
# Copy to `.env` and fill in real values. Everything below is documented in
# README.md under "Environment Variables".
# =============================================================================

# --- Database -----------------------------------------------------------------
# When running via docker-compose the backend container talks to the postgres
# service on the internal network, so use `postgres:5432`. When running the
# backend locally against a dev Postgres, point at your local port instead.
VECTOR_DB_URL=jdbc:postgresql://postgres:5432/launchpad
VECTOR_DB_USER=launchpad
VECTOR_DB_PASS=change_me

# --- Deploy hook --------------------------------------------------------------
# Shared secret used to HMAC-verify POSTs to /deploy-hook. GitHub Actions (or
# whatever CI you use) must sign the request body with this secret and send the
# hex digest in the `X-Signature-256` header as `sha256=<digest>`. REQUIRED.
# Generate with:  openssl rand -hex 32
VECTOR_DEPLOY_HOOK_SECRET=change_me

# --- Docker socket ------------------------------------------------------------
# How the backend JVM talks to the Docker daemon (path inside the container).
# VECTOR_DOCKER_SOCKET_PATH is the host path that compose mounts into each service.
# On Linux keep /var/run/docker.sock for both. On macOS with OrbStack/Colima
# the host path is different (e.g. ~/.orbstack/run/docker.sock).
VECTOR_DOCKER_SOCKET=unix:///var/run/docker.sock
VECTOR_DOCKER_SOCKET_PATH=/var/run/docker.sock

# --- DockerHub pulls ----------------------------------------------------------
# Credentials used to pull deployed app images from DockerHub. Create a token
# at https://hub.docker.com/settings/security with read-only scope.
VECTOR_DOCKERHUB_USER=
VECTOR_DOCKERHUB_TOKEN=

# --- Deploy defaults ----------------------------------------------------------
# Fallback container port if a deployment doesn't declare one.
VECTOR_APP_DEFAULT_PORT=3000

# --- Encryption ---------------------------------------------------------------
# AES key used to encrypt stored environment variables in the database.
# Generate with:  openssl rand -base64 32
# REQUIRED — rotating this value will make existing encrypted values unreadable.
# Back this up separately from the rest of the .env file.
VECTOR_ENCRYPTION_KEY=generate_with_openssl_rand_base64_32

# --- Notifications (Resend) ---------------------------------------------------
# Used to send deploy success/failure emails. Leave VECTOR_RESEND_API_KEY blank
# to disable notifications.
VECTOR_RESEND_API_KEY=
VECTOR_RESEND_FROM=Vector <onboarding@resend.dev>
VECTOR_RESEND_TO=your@email.com

# --- Vector API key -----------------------------------------------------------
# Shared secret required on the X-API-Key header for every /api/** request.
# Generate with:  openssl rand -hex 32
VECTOR_API_KEY=generate_with_openssl_rand_hex_32

# --- GitHub integration -------------------------------------------------------
# Personal access token used to fetch commit metadata. Leave blank to disable;
# the feature degrades silently.
VECTOR_GITHUB_TOKEN=

# --- AI log analysis (Gemini) -------------------------------------------------
# The "Ask AI: Analyze Logs" feature calls the Gemini API. Get a free API key
# from https://aistudio.google.com/apikey — the free tier allows 15 RPM.
# REQUIRED when using the default Gemini provider.
VECTOR_GEMINI_API_KEY=

# Ollama fallback (optional, self-hosted) — set vector.ai.provider=ollama in
# application.properties and uncomment the ollama service in docker-compose.yml
# VECTOR_OLLAMA_BASE_URL=http://localhost:11434
# VECTOR_OLLAMA_MODEL=llama3.2:3b

# --- vector-analyzer (Time Machine backend) -----------------------------------
# Dedicated Postgres user for vector-analyzer. Run postgres/init/02-vector-analyzer-user.sql
# on the Postgres container to create the user (done automatically on fresh containers).
VECTOR_ANALYZER_DB_USER=vector_analyzer
VECTOR_ANALYZER_DB_PASS=change_me

# How many days / deployments worth of logs to keep (hybrid retention policy).
VECTOR_LOG_RETENTION_DAYS=30
VECTOR_LOG_RETENTION_DEPLOYS=5

# --- Self-app images ----------------------------------------------------------
# Docker images used for the self-hosted Vector services. Overriding these lets
# you point at a fork or a specific SHA-tagged image instead of latest.
VECTOR_BACKEND_IMAGE=filipn123/vector-api:latest
VECTOR_FRONTEND_IMAGE=filipn123/vector-web:latest

# --- Security -----------------------------------------------------------------
# Comma-separated list of reverse-proxy IPs whose X-Forwarded-For header is
# trusted for rate-limiting purposes. Leave blank in local dev. On VPS with
# Traefik, set to Traefik's Docker bridge IP (e.g. 172.18.0.2).
VECTOR_TRUSTED_PROXIES=

# Shared token authenticating vector-api -> vector-updater calls. Generate with:
#   openssl rand -hex 32
# Set the same value on both the vector-api and vector-updater containers (compose
# already forwards VECTOR_UPDATER_AUTH_TOKEN to both). Leave blank in local dev —
# both ends bypass the check when empty.
VECTOR_UPDATER_AUTH_TOKEN=

# --- HTTPS / Traefik (VPS only) -----------------------------------------------
# Used by docker-compose.https.yml to issue Let's Encrypt certificates.
# VECTOR_ACME_EMAIL receives expiry notices from Let's Encrypt.
# VECTOR_DOMAIN_API and VECTOR_DOMAIN_WEB are the public hostnames pointed at
# this server's public IP (A/AAAA records). For local dev these are unused;
# the base docker-compose.yml routes via *.localhost over HTTP.
VECTOR_ACME_EMAIL=
VECTOR_DOMAIN_API=
VECTOR_DOMAIN_WEB=

# --- Frontend dashboard -------------------------------------------------------
# Password users enter on the dashboard login screen.
VECTOR_DASHBOARD_PASSWORD=change_me
# HMAC secret for signed session cookies. Generate with:  openssl rand -hex 32
VECTOR_SESSION_SECRET=generate_with_openssl_rand_hex_32

# Public hostname suffix for deployed app subdomains (e.g. apps.example.com).
# Inlined at vector-web build time (Next.js NEXT_PUBLIC_*); change requires a
# rebuild of the vector-web image, not just a container restart.
NEXT_PUBLIC_APP_BASE_DOMAIN=localhost

# --- Optional / runtime overrides ---------------------------------------------
# Public URL of the vector-api (used in generated webhook templates).
VECTOR_PUBLIC_BASE_URL=

# Internal updater base URL (compose default works for self-hosted runs).
VECTOR_UPDATER_BASE_URL=http://vector-updater:8080
VECTOR_COMPOSE_PROJECT_NAME=vector-platform

# AI provider tunables (analyzer). Leave defaults unless you've benchmarked.
VECTOR_AI_PROVIDER=gemini
VECTOR_GEMINI_MODEL=gemini-2.0-flash
VECTOR_GEMINI_TIMEOUT_SECONDS=60
VECTOR_AI_MAX_REGENERATIONS=2
