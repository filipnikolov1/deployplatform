# =============================================================================
# Launchpad environment configuration
# Copy to `.env` and fill in real values. Everything below is documented in
# README.md under "Environment Variables".
# =============================================================================

# --- Database -----------------------------------------------------------------
# When running via docker-compose the backend container talks to the postgres
# service on the internal network, so use `postgres:5432`. When running the
# backend locally against a dev Postgres, point at your local port instead.
DB_URL=jdbc:postgresql://postgres:5432/launchpad
DB_USERNAME=launchpad
DB_PASSWORD=change_me

# --- Deploy hook --------------------------------------------------------------
# Shared secret used to HMAC-verify POSTs to /deploy-hook. GitHub Actions (or
# whatever CI you use) must sign the request body with this secret and send the
# hex digest in the `X-Signature-256` header as `sha256=<digest>`. REQUIRED.
# Generate with:  openssl rand -hex 32
DEPLOY_HOOK_SECRET=change_me

# --- Docker socket ------------------------------------------------------------
# How the backend talks to the Docker daemon.
#   DOCKER_SOCKET      : what the backend JVM sees (path inside the container)
#   DOCKER_SOCKET_PATH : where the host socket actually lives (compose mounts it)
# On Linux keep /var/run/docker.sock for both. On macOS with OrbStack/Colima
# the host path is different (e.g. ~/.orbstack/run/docker.sock).
DOCKER_SOCKET=unix:///var/run/docker.sock
DOCKER_SOCKET_PATH=/var/run/docker.sock

# --- DockerHub pulls ----------------------------------------------------------
# Credentials used to pull deployed app images from DockerHub. Create a token
# at https://hub.docker.com/settings/security with read-only scope.
DOCKERHUB_USERNAME=
DOCKERHUB_TOKEN=

# --- Deploy defaults ----------------------------------------------------------
# Fallback container port if a deployment doesn't declare one.
APP_DEFAULT_PORT=3000

# --- Encryption ---------------------------------------------------------------
# AES key used to encrypt stored environment variables in the database.
# Generate with:  openssl rand -base64 32
# REQUIRED — rotating this value will make existing encrypted values unreadable.
ENCRYPTION_KEY=generate_with_openssl_rand_base64_32

# --- Notifications (Resend) ---------------------------------------------------
# Used to send deploy success/failure emails. Leave RESEND_API_KEY blank to
# disable notifications.
RESEND_API_KEY=
RESEND_FROM=Launchpad <onboarding@resend.dev>
RESEND_TO=your@email.com

# --- Launchpad API key --------------------------------------------------------
# Shared secret required on the X-API-Key header for every /api/** request.
# Generate with:  openssl rand -hex 32
APP_API_KEY=generate_with_openssl_rand_hex_32

# --- Ollama (AI log analysis) -------------------------------------------------
# The backend talks to a local Ollama server for the "Ask AI: Analyze Logs"
# feature. When running via docker-compose the compose file already points the
# backend at the bundled ollama service, so you usually don't need to set these.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# --- Frontend dashboard -------------------------------------------------------
# Password users enter on the dashboard login screen.
DASHBOARD_PASSWORD=change_me
# HMAC secret for signed session cookies. Generate with:  openssl rand -hex 32
SESSION_SECRET=generate_with_openssl_rand_hex_32
