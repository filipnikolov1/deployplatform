name: Deploy @@app@@ to Vector
on:
  push:
    branches: ["@@branch@@"]

jobs:
  deploy:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - uses: docker/setup-buildx-action@v3

      - uses: docker/login-action@v3
        with:
          username: ${{ secrets.DOCKERHUB_USERNAME }}
          password: ${{ secrets.DOCKERHUB_TOKEN }}

      # TODO: Add any language-specific build steps here before the Docker build

      - name: Build and push image
        run: |
          SHA=$(echo "$GITHUB_SHA" | cut -c1-7)
          IMAGE="${{ secrets.DOCKERHUB_USERNAME }}/@@app@@:git-$SHA"
          docker buildx build --platform linux/amd64 --push -t "$IMAGE" .
          echo "IMAGE=$IMAGE" >> "$GITHUB_ENV"

      - uses: filipnikolov1/vector-deploy-action@v1
        with:
          app: "@@app@@"
          image: ${{ env.IMAGE }}
          url: ${{ secrets.VECTOR_DEPLOY_URL }}
          secret: ${{ secrets.VECTOR_HMAC_SECRET }}
