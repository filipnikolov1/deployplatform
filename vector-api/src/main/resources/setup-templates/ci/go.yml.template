name: Deploy @@app@@ to Vector
on:
  push:
    branches: ["@@branch@@"]

jobs:
  deploy:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-go@v5
        with:
          go-version: "1.23"

      - uses: docker/setup-buildx-action@v3

      - uses: docker/login-action@v3
        with:
          username: ${{ secrets.DOCKERHUB_USERNAME }}
          password: ${{ secrets.DOCKERHUB_TOKEN }}

      - name: Build and push image
        run: |
          SHA=$(echo "$GITHUB_SHA" | cut -c1-7)
          IMAGE="${{ secrets.DOCKERHUB_USERNAME }}/@@app@@:git-$SHA"
          docker buildx build --platform linux/amd64 --push -t "$IMAGE" .
          echo "IMAGE=$IMAGE" >> "$GITHUB_ENV"

      - name: Trigger Vector deploy
        run: |
          TIMESTAMP=$(date +%s%3N)
          PAYLOAD=$(jq -n \
            --arg app "@@app@@" \
            --arg image "$IMAGE" \
            --arg branch "@@branch@@" \
            --arg commit_sha "$GITHUB_SHA" \
            --arg commit_message "$(git log -1 --pretty=%s)" \
            --arg commit_author "$(git log -1 --pretty=%an)" \
            --argjson commit_timestamp "$(git log -1 --format='%ct')" \
            --argjson timestamp "$TIMESTAMP" \
            '{app_name: $app, image: $image, branch: $branch, commit_sha: $commit_sha, commit_message: $commit_message, commit_author: $commit_author, commit_timestamp: $commit_timestamp, timestamp: $timestamp}')
          SIG=$(printf '%s' "$PAYLOAD" | openssl dgst -sha256 -hmac "${{ secrets.VECTOR_HMAC_SECRET }}" | sed 's/.* //')
          curl -fsSL -X POST "${{ secrets.VECTOR_DEPLOY_URL }}" \
            -H "Content-Type: application/json" \
            -H "X-Signature-256: sha256=$SIG" \
            -d "$PAYLOAD"
